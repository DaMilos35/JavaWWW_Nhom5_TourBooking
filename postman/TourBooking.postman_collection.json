{
  "info": {
    "_postman_id": "21f1d65f-2087-4f3e-903f-6b0f64d14efa",
    "name": "Du Lich Viet - Tomcat API",
    "description": "Bộ request kiểm thử API Java Servlet trên Tomcat. Đăng nhập để tự lưu JWT vào collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "tourId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Customer login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('customerToken', pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register customer",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new_customer\",\n  \"email\": \"new_customer@example.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Khách hàng mới\",\n  \"phone\": \"0901234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Public catalog",
      "item": [
        {
          "name": "List categories",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "categories"
              ]
            }
          }
        },
        {
          "name": "List active tours",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tours",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tours"
              ]
            }
          }
        },
        {
          "name": "Search tours",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tours/search?keyword=Hạ%20Long",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tours",
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "Hạ Long"
                }
              ]
            }
          }
        },
        {
          "name": "Filter tours",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tours/filter?categoryId={{categoryId}}&minPrice=1000000&maxPrice=10000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tours",
                "filter"
              ],
              "query": [
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}"
                },
                {
                  "key": "minPrice",
                  "value": "1000000"
                },
                {
                  "key": "maxPrice",
                  "value": "10000000"
                }
              ]
            }
          }
        },
        {
          "name": "Tour details",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tours/{{tourId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tours",
                "{{tourId}}"
              ]
            }
          }
        }
      ]
    },
    {
