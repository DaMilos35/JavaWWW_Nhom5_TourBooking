        },
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('orderId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactName\": \"Nguyễn Văn An\",\n  \"contactPhone\": \"0901234567\",\n  \"contactEmail\": \"customer@tourbooking.com\",\n  \"notes\": \"Đặt thử qua Postman\",\n  \"items\": [\n    {\n      \"tourId\": {{tourId}},\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "My orders",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/my",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "my"
              ]
            }
          }
        },
        {
          "name": "Get order by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          }
        },
        {
          "name": "Cancel pending order",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/cancel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "cancel"
              ]
            }
          }
        }
      ]
