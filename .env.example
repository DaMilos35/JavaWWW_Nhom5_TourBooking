# Optional local-only port and credential overrides for Docker Compose.
# Compose has development-only defaults, so this file is not required to start.
WEB_PORT=3000
API_PORT=8080
DB_PORT=3307
MARIADB_ROOT_PASSWORD=change-this-local-root-password
MARIADB_PASSWORD=change-this-local-database-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
