        <mxCell id="m0" value="Nhập 15 khách, tick 'Đặt tour B2B', nhập MST &amp; Tên Công Ty" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=0.5;exitY=0.0874;entryX=0;entryY=0.0;" edge="1" parent="1" source="b2b" target="act6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="POST /api/orders (OrderRequest: 15 khách, isB2B=true, MST=...)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0588;entryX=0;entryY=0.0;" edge="1" parent="1" source="act6" target="act5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="createOrder(request, authenticatedUser)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0667;entryX=0;entryY=0.0;" edge="1" parent="1" source="act5" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="findByIdForUpdate(tourId) [@Lock PESSIMISTIC_WRITE]" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.0769;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="SELECT * FROM tours WHERE id=? FOR UPDATE" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m5" value="Tour Entity (availableSeats: 25)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.6667;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="Tour Entity lock granted" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=1;entryY=0.3077;" edge="1" parent="1" source="act1" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note7" value="Thuật toán chiết khấu B2B: 15 khách thuộc bậc [10-19 khách] -&gt; Áp dụng giảm 5%" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1040" y="460" width="250" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="calculateDiscount(15 pax) -&gt; Chiết khấu 5% tổng tiền" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.4769;entryX=1;entryY=0.5231;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1080" y="540"/><mxPoint x="1080" y="570"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="deductSeats(25 - 15 = 10 chỗ khả dụng)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.5846;entryX=1;entryY=0.6308;" edge="1" parent="1" source="act4" target="act4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1080" y="610"/><mxPoint x="1080" y="640"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="save(Order: isB2B=1, discount=5%, code=ORD-2026...)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.6923;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m11" value="INSERT INTO orders &amp; orderdetails" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;exitX=1;exitY=0.3333;entryX=0;entryY=0.0;" edge="1" parent="1" source="act3" target="act2">
