  <diagram id="hinh_3_11__s_____l_p_th_c_th__jpa_class_diagram" name="Hinh 3.11: Sơ đồ Lớp Thực thể JPA Class Diagram">
    <mxGraphModel dx="1420" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="720" math="0" shadow="0">
      <root>
